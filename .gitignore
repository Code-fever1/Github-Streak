# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# streak-keeper: private config, clones, API secrets, SSH keys
/streak-keeper/config.json
/streak-keeper/.env
/streak-keeper/.env.*
!/streak-keeper/.env.example
/streak-keeper/work/
/streak-keeper/state/
/streak-keeper/local/
**/secrets.json
**/pending-keys.json

# SSH / tokens — never commit
**/.ssh/id_*
!**/.ssh/*.pub.example
*.pem
*.key
*_rsa
*_ed25519
!*_ed25519.pub

# Expo / React Native
/mobile/.expo/
/mobile/dist/
/mobile/web-build/
/mobile/.env
/mobile/.env.*
!/mobile/.env.example

# Local machine notes (Azure IP, tokens) — optional
PRIVATE.md
local-notes.md
*.local.json
!*.local.example.json
