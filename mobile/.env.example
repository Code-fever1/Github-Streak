# Copy to .env for local Expo dev (never commit .env)
# Restart Expo after changing: npx expo start --clear

# Your Azure VM public URL (open port 8787 in Azure NSG)
EXPO_PUBLIC_STREAK_SERVER_URL=http://YOUR_AZURE_PUBLIC_IP:8787

# Optional: pre-fill API token in Settings (stored in device secure storage after save)
# EXPO_PUBLIC_STREAK_API_TOKEN=
