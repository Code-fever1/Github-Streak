{
  "name": "streak-keeper",
  "version": "1.0.0",
  "description": "Server-side GitHub contribution streak maintainer. Commits realistic, randomized changes to a private repo on an hourly schedule.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "streak-keeper": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "serve": "node src/index.js --serve",
    "plan": "node src/index.js --plan-only",
    "once": "node src/index.js --once",
    "test": "node src/index.js --self-test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
