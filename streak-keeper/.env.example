# Copy to .env on the server (never commit .env)
# Used by install-api.sh and systemd

STREAK_HOST=0.0.0.0
STREAK_PORT=8787

# Generate: openssl rand -hex 24
STREAK_API_TOKEN=replace-with-long-random-secret

STREAK_WORK_DIR=$HOME/.streak-keeper/work
STREAK_STATE_DIR=$HOME/.streak-keeper/state

STREAK_GIT_NAME=Your Name
STREAK_GIT_EMAIL=you@users.noreply.github.com

# Optional: path to your GitHub SSH private key on the Azure VM
# STREAK_GITHUB_SSH_KEY=$HOME/.ssh/id_ed25519
